# =============================================================================
# BAA 生产部署配置模板（T-C5）
# 复制为 .env 并与 docker-compose.yml 同目录；compose 自动加载
# =============================================================================

# ── 服务 ─────────────────────────────────────────────────
BAA_PORT=8000
BAA_WORKERS=4                    # CPU 密集型建议 2-4

# ── 安全（生产必填）───────────────────────────────────────
# 管理密钥：必须改为强随机值（python -c "import secrets; print(secrets.token_urlsafe(32))"）
BAA_API_KEY=CHANGE_ME_TO_STRONG_RANDOM
# 匿名放行：生产必须为 0
BAA_ALLOW_ANONYMOUS=0
# PDF 解析 AGPL 进程隔离：生产必须为 1
BAA_PDF_ISOLATION=1
# 结构化日志（Loki/ELK 可检索）
BAA_LOG_FORMAT=json

# ── PostgreSQL（T-C1/T-C2 统一数据层）──────────────────────
POSTGRES_USER=baa
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_RANDOM
POSTGRES_DB=baa

# ── 数据存储 ─────────────────────────────────────────────
BAA_DATA_DIR=/app/data
